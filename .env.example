# All optional. Defaults shown.
HTTP_ADDR=:8080
REDIS_ADDR=localhost:6379        # "disabled" turns caching off
CACHE_TTL=30s
DATABASE_URL=                    # postgres://user:pass@host:5432/db?sslmode=disable ; empty = live provider mode
SUPPORTED_SPORTS=football,basketball,tennis,cricket
PROVIDER_TIMEOUT=8s
MAX_PROVIDER_CONCURRENCY=16
SPORTSCORE_BASE_URL=             # override for tests/mocks
WS_ALLOWED_ORIGINS=              # comma-separated host patterns allowed to open WebSockets
INGEST_ENABLED=false             # run the ingest worker inside the API (needs DATABASE_URL)
INGEST_INTERVAL=30s
INGEST_LIMIT=50
INGEST_SPORTS=                   # defaults to SUPPORTED_SPORTS
